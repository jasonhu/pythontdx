# ---------------------------------------------------------------- 镜像配置
# 国内网络下 GitHub Releases 基本不可达，Electron 二进制必须走镜像，
# 否则 `npm run dev` 会在下载 electron.exe 时卡住/报 "fetch failed"。
#
# Electron 的下载器会读取 npm_config_electron_mirror / npm_config_electron_custom_dir，
# 而 npm 会把 .npmrc 里的键注入成 npm_config_* 环境变量并传递给子进程，
# 所以在这里配置一次，`npm run dev` 就能自动走镜像。
electron_mirror=https://npmmirror.com/mirrors/electron/
# npmmirror 的目录结构是 /44.4.3/ 而不是 GitHub 的 /v44.4.3/
electron_custom_dir={{ version }}

# 可选：把 npm 本身也换成国内源（网络通畅时无需开启）
# registry=https://registry.npmmirror.com/
