{
  "name": "stocklens",
  "version": "0.14.3",
  "private": true,
  "description": "StockLens · 高颜值跨平台股票行情终端（Electron + Vite + SolidJS）",
  "author": "River",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/riverzhou/pythontdx",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:watch": "electron-vite dev --watch",
    "build": "electron-vite build",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts --port 4174",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:python": "node scripts/python.mjs test",
    "audit:data": "node scripts/python.mjs audit",
    "build:python": "node scripts/python.mjs build",
    "icon": "node scripts/generate-icon.mjs",
    "shot": "npm run build && node scripts/screenshot.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:python",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"scripts/**/*.mjs\" \"docs/**/*.md\" \"*.{json,md,yml}\" \".vscode/*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\"",
    "build:win": "npm run build:python && npm run build && electron-builder --win",
    "build:win:portable": "npm run build:python && npm run build && electron-builder --win portable",
    "build:win:setup": "npm run build:python && npm run build && electron-builder --win nsis",
    "build:mac": "npm run build:python && npm run build && electron-builder --mac",
    "build:linux": "npm run build:python && npm run build && electron-builder --linux",
    "shot:web": "electron scripts/web-shot.cjs",
    "archive:snapshot": "python3 scripts/archive-snapshot.py"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "pinyin-pro": "^3.29.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.9.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-solid": "^0.18.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "solid-js": "^1.9.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.1"
  },
  "desktopName": "stocklens",
  "linux": {
    "syncDesktopName": true
  }
}
